# Copy to .env.production.local. Never use development credentials in production.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PAGES_NAME=ai-native-notes-a4913994
WORKER_NAME=ai-native-notes-server
DB_NAME=ai-native-notes
R2_BUCKET_NAME=ai-native-notes-images
TASK_QUEUE_NAME=ai-native-notes-tasks
# Activate the custom domain on this Pages project before publishing.
FRONTEND_URL=https://aifield.cc
NAME=AI Native Notes
DESCRIPTION=记录 AI Native 时代的技术笔记与项目实践 / Technical notes and project practice in the AI-native era.
AVATAR=/avatar.svg
PAGE_SIZE=5
RSS_ENABLE=true
RSS_TITLE=AI Native Notes
RSS_DESCRIPTION=Technical notes and project practice in the AI-native era.
CACHE_STORAGE_MODE=database
S3_FOLDER=images/
S3_CACHE_FOLDER=cache/aifield.cc/
S3_REGION=auto
# Actual same-origin public image endpoint. R2 service binding authorizes storage access.
S3_ACCESS_HOST=https://aifield.cc/api/blob
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
