# Local development only. Run scripts/blog-init.ts to generate unique credentials.
NAME=AI Native Notes
DESCRIPTION=记录 AI Native 时代的技术笔记与项目实践 / Technical notes and project practice in the AI-native era.
AVATAR=/avatar.svg
PAGE_SIZE=5
RSS_ENABLE=true
RSS_TITLE=AI Native Notes
RSS_DESCRIPTION=Technical notes and project practice in the AI-native era.
FRONTEND_URL=http://localhost:11498
WORKER_NAME=ai-native-notes-dev
DB_NAME=ai-native-notes-dev
CACHE_STORAGE_MODE=database
# Wrangler emulates this bucket locally. No cloud account or S3 keys needed.
R2_BUCKET_NAME=ai-native-notes-images-dev
S3_FOLDER=images/
S3_CACHE_FOLDER=cache/
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_HOST=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
RIN_GITHUB_CLIENT_ID=
RIN_GITHUB_CLIENT_SECRET=
